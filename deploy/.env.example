# ==============================================================================
# Workforce Vision Platform (WVP) - Environment Variables Template
# Generate secure random keys before deploying to production:
#   JWT_SECRET:               openssl rand -hex 32
#   AES_ENCRYPTION_KEY:       openssl rand -hex 32 (must be exactly 64 hex characters)
#   INTERNAL_SERVICE_SECRET:  openssl rand -hex 32
#   POSTGRES_PASSWORD:        openssl rand -base64 24
# ==============================================================================

ENV=production

# Database
POSTGRES_DB=wfv_db
POSTGRES_USER=wfv_app
POSTGRES_PASSWORD=CHANGE_ME_GENERATE_VIA_OPENSSL

# JWT Authentication
JWT_SECRET=CHANGE_ME_GENERATE_VIA_OPENSSL_RAND_HEX_32

# AES-256-GCM Key (64 hexadecimal characters = 32 bytes)
AES_ENCRYPTION_KEY=CHANGE_ME_GENERATE_VIA_OPENSSL_RAND_HEX_32_EXACTLY_64_CHARS

# Internal HMAC service-to-service secret
INTERNAL_SERVICE_SECRET=CHANGE_ME_GENERATE_VIA_OPENSSL_RAND_HEX_32
